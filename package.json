{
  "name": "okzbyte",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:seo": "node scripts/verify-seo.mjs && node scripts/verify-seo-headings.mjs && node scripts/verify-prerender.mjs",
    "typecheck:seo": "tsc --noEmit --allowJs --checkJs --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler src/seo.js",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "pg": "^8.16.3",
    "react": "latest",
    "react-dom": "latest",
    "simple-icons": "^16.37.0",
    "three": "^0.187.0",
    "typescript": "latest",
    "vite": "latest"
  }
}
