# Server
PORT=3000
NODE_ENV=development

# PostgreSQL / Supabase server-side connection string only
DATABASE_URL=postgresql://user:password@localhost:5432/okzbyte

# Admin provisioning: provide a pre-hashed password, never commit a plaintext password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Optional absolute origin for canonical links
SITE_URL=https://okzbyte.com
