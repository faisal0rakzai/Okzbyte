# Server
PORT=3000
NODE_ENV=development

# PostgreSQL / Supabase server-side connection string only
DATABASE_URL=postgresql://user:password@localhost:5432/okzbyte

# Admin provisioning: provide a pre-hashed password, never commit a plaintext password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Optional absolute origin for canonical links
SITE_URL=https://okzbyte.vercel.app

# Supabase server-side integration. Never expose the secret key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
CAREERS_NOTIFICATION_EMAIL=careers@example.com
# Optional support inbox used for new contact inquiries and support tickets
SUPPORT_NOTIFICATION_EMAIL=support@example.com

# Optional Resend transactional email integration.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=OkzByte <support@example.com>
